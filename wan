from pytorch/pytorch:2.6.0-cuda12.6-cudnn9-devel
# 设置非交互模式
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
# 默认yes
run  apt update && apt upgrade -y
run apt install -y vim git ffmpeg libreoffice
run git clone https://github.com/Wan-Video/Wan2.1.git
run pip install wheel packaging
run pip install pyproject-toml
run cd Wan2.1 && ls &&  pip install -r requirements.txt
